# Firebase Test Lab credentials
# Copy to scripts/.env.firebase and fill in your values.
# .env.firebase is gitignored — never commit it.

# Google Cloud project ID (shown in Firebase console → Project settings)
FIREBASE_PROJECT_ID=your-project-id

# Path to service account JSON key
# (Firebase console → Project settings → Service accounts → Generate new private key)
GOOGLE_APPLICATION_CREDENTIALS=~/.config/gcloud/glucodroid-firebase-sa.json

# GCS results bucket — usually <project-id>.appspot.com (created automatically)
FIREBASE_RESULTS_BUCKET=your-project-id.appspot.com

# Physical device to run on (Pixel 6 = oriole, supports ODPM power rails on API 33+)
# List available: gcloud firebase test android models list --filter="form=PHYSICAL"
FIREBASE_DEVICE_MODEL=oriole
FIREBASE_DEVICE_VERSION=33
FIREBASE_DEVICE_LOCALE=en
FIREBASE_DEVICE_ORIENTATION=portrait

# Test timeout (free Spark tier: keep under ~10 min per run to stay within daily quota)
FIREBASE_TEST_TIMEOUT=10m

# Where to save downloaded results locally
FIREBASE_RESULTS_BASE=./firebase-test-results
